<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Определение PreProcessor -->
    <bean id="preProcessorToUpper" class="edu.school21.Spring.Preprocessor.PreProcessorToUpperImpl"/>
    <bean id="preProcessorToLower" class="edu.school21.Spring.Preprocessor.PreProcessorToLowerImpl"/>

    <!-- Определение Renderer -->
    <bean id="rendererErr" class="edu.school21.Spring.Renderer.RendererErrImpl">
        <constructor-arg ref="preProcessorToUpper"/>
    </bean>

    <bean id="rendererStandard" class="edu.school21.Spring.Renderer.RendererStandardImpl">
        <constructor-arg ref="preProcessorToLower"/>
    </bean>

    <bean id="rendererStandardUpper" class="edu.school21.Spring.Renderer.RendererStandardImpl">
        <constructor-arg ref="preProcessorToUpper"/>
    </bean>

    <!-- Определение Printer -->
    <bean id="printerWithPrefix" class="edu.school21.Spring.Printer.PrinterWithPrefixImpl">
        <constructor-arg ref="rendererStandardUpper"/>
        <property name="prefix" value="PREFIX"/>
    </bean>

    <bean id="printerWithDateTime" class="edu.school21.Spring.Printer.PrinterWithDateTimeImpl">
        <constructor-arg ref="rendererErr"/>
    </bean>
</beans>